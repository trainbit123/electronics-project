# ========================================================
# TechMatch Backend Environment Variables
# ========================================================

# Server Port
PORT=5000
NODE_ENV=development

# --------------------------------------------------------
# MongoDB Connection URL
# Replace <username> and <password> with your actual MongoDB Atlas
# database user credentials, or use a local MongoDB instance.
# Example Atlas URL:
# MONGODB_URI=mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/techmatch?retryWrites=true&w=majority
# Example Local URL:
# MONGODB_URI=mongodb://localhost:27017/techmatch
# --------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/techmatch?retryWrites=true&w=majority

# --------------------------------------------------------
# JWT Authentication Secret & Expiration
# Use a long, unpredictable random string for production
# --------------------------------------------------------
JWT_SECRET=techmatch_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
